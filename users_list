<h2>User Directory</h2>
<a href="{% url 'user_create' %}" style="display:inline-block; margin-bottom:15px;">+ Add New User</a>

<table border="1" cellpadding="8" style="border-collapse: collapse; width: 100%;">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.username }}</td>
            <td>{{ user.email }}</td>
            <td>{{ user.phone|default:"—" }}</td>
            <td>
                <a href="{% url 'user_update' user.pk %}">Edit</a> | 
                <a href="{% url 'user_delete' user.pk %}" style="color:red;">Delete</a>
            </td>
        </tr>
        {% empty %}
        <tr>
            <td colspan="4">No users found.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
